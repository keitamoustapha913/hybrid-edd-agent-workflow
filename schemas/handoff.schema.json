{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalized specialist handoff proposal",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "producer_role": { "type": "string" },
    "producer_run_id": { "type": "string" },
    "mvp_id": { "type": "string" },
    "reported_status": { "type": "string" },
    "producer_report_path": { "type": "string" },
    "output_paths": { "type": "array", "items": { "type": "string" } },
    "evidence_paths": { "type": "array", "items": { "type": "string" } },
    "criterion_ids": { "type": "array", "items": { "type": "string" } },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["ERROR", "WARNING"] },
          "detail": { "type": "string" }
        },
        "required": ["code", "severity", "detail"],
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["READY_FOR_VALIDATION", "RETURN_TO_PRODUCER", "NEEDS_HUMAN"]
    }
  },
  "required": [
    "schema_version", "producer_role", "producer_run_id", "mvp_id",
    "reported_status", "producer_report_path", "output_paths",
    "evidence_paths", "criterion_ids", "issues", "recommendation"
  ],
  "additionalProperties": false
}
